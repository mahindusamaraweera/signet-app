# Copy to .env (or export these as real environment variables) before
# running the API. The backend connects DIRECTLY to your existing Signet
# MySQL database — no separate/new database is created.

APP_NAME=Signetint.net
APP_URL=http://127.0.0.1:8080
APP_ENV=local
PORT=8080

# Point these at your EXISTING crypto-app database (same values as that
# app's .env DB_* keys).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=signet_last
DB_USERNAME=root
DB_PASSWORD=

# Used to sign the session JWT stored in the httpOnly signet_session cookie.
# Set this to a long random value in production.
SESSION_SECRET=change-me-to-a-long-random-value
SESSION_LIFETIME=120

# Package funding uses the separate custody service. Both the scheduler and
# this integration must be enabled for automatic activation. Configure the
# matching deployed service and its server-only credential before enabling.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_SERVICE_URL=
BLOCKCHAIN_SERVICE_TOKEN=
# Optional top-ups and commission workers; enable only with matching custody
# endpoints and commission processing configured on that service.
BLOCKCHAIN_TOPUP_ENABLED=false
BLOCKCHAIN_COMMISSION_PREPARATION_ENABLED=false
BLOCKCHAIN_COMMISSION_DELIVERY_ENABLED=false

# Server-only approval key shared with signet-token. Generate independently
# from SESSION_SECRET and BLOCKCHAIN_SERVICE_TOKEN; minimum 32 random bytes.
# Empty disables withdrawal assertion signing. Never expose to the frontend.
SIGNET_APP_WITHDRAWAL_AUTHORIZATION_KEY=
BLOCKCHAIN_WITHDRAWAL_SUBMISSION_ENABLED=false
BLOCKCHAIN_WITHDRAWAL_CANCELLATION_ENABLED=false
SIGNET_APP_WITHDRAWAL_CALLBACK_TOKEN=

# Outbound mail (registration/password-reset notifications). Point at any
# SMTP server; a local Mailhog/Mailpit on 127.0.0.1:1025 works for dev.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com

# Mining webhook (jobs.RunMiningWebhook) — optional, off by default.
MINING_WEBHOOK_ENABLED=false
MINING_WEBHOOK_URL=
MINING_WEBHOOK_SECRET=

# CORS origin allowed to call this API with credentials — the Vue dev
# server's origin in local dev; your deployed frontend's origin in prod.
FRONTEND_ORIGIN=http://localhost:5173

# Runs the in-process recurring jobs (mining:update, mining:send-webhook,
# packages:weekly-sum, share:calculate, and enabled blockchain activation
# workers) on this process. Leave true for a
# single-instance deployment; if you run more than one API process against
# the same database, set this to false on every instance but one so the
# jobs don't run twice.
ENABLE_SCHEDULER=true

# Opt-in expiry of NEW verified registrations only. Existing users are never
# enrolled/backfilled. Apply migration 030 before enabling. Blockchain-mode
# deletion also needs SIGNET_APP_REGISTRATION_EXPIRY_ENABLED on signet-token,
# a healthy deposit scanner and an authoritative zero-funds custody seal.
REGISTRATION_EXPIRY_ENABLED=false

# Where uploaded KYC images are stored: "local" (./storage) or "s3".
# With s3, images not yet copied to the bucket are still served from
# ./storage. See docs/S3_SETUP.md.
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
# Only for S3-compatible stores (MinIO, R2, ...); leave empty for AWS.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Daily database backup (deploy/backup/signet-db-backup.sh). Defaults:
# s3://$AWS_BUCKET/db-backups, local copies in /var/backups/signet kept 3 days.
# BACKUP_S3_URI=s3://your-bucket/db-backups
# BACKUP_KEEP_LOCAL_DAYS=3
# BACKUP_IGNORE_TABLES=jobs
